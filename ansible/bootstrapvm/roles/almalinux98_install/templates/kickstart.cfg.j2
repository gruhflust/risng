#version=ALMALINUX
# RIS8 phase 1 - AlmaLinux 9.8 base install (automated, no Puppet, no LP3)
# Generated by almalinux98_install role on the RISng staging host.
install
text
reboot
lang en_US.UTF-8
keyboard --vckeymap=de --xlayouts='de'
timezone UTC
selinux --disabled
firewall --disabled
authselect select --nsswitch-file=/etc/nsswitch.conf minimal

# Network: DHCP on boot interface (MAC-based role routing happens after install)
network --bootproto=dhcp --device=bootif --activate --onboot=yes --noipv6

# Base repo: locally mirrored AlmaLinux 9.8 DVD tree (Anaconda-ready layout:
# each component dir holds repodata/ + Packages/)
repo --name="almalinux98-baseos" --baseurl="http://{{ tftp_server_ip }}/{{ almalinux98_repo_relative }}/BaseOS" --cost=100
repo --name="almalinux98-appstream" --baseurl="http://{{ tftp_server_ip }}/{{ almalinux98_repo_relative }}/AppStream" --cost=100

# Access: root password locked; SSH key-only (controlhost key published by RISng).
rootpw --lock

# Disk layout
zerombr
clearpart --all --initlabel
autopart --type=lvm

bootloader --location=mbr
bootloader --driveorder=hda

%packages --ignoremissing
@core
@base
dnf
dnf-plugins-core
python3
python3-dnf
cronie
rsyslog
openssh-server
openssh-clients
sssd
oddjob
authselect
authselect-libs
iproute
iputils
kexec-tools
grub2-tools
gdb
less
nano
vim-enhanced
tar
which
file
findutils
rsync
curl
wget
jq
net-tools
ethtool
tcpdump
traceroute
mtr
iperf3
htop
iotop
sysstat
smartmontools
lshw
pciutils
usbutils
gdisk
parted
util-linux
dosfstools
mkfs_xfs
e2fsprogs
systemd
systemd-sysv
dracut
dracut-network
grub2-tools-minimal
kernel
kernel-modules
%end

%pre --log=/var/log/risng-pre.log
set -euxo pipefail
# ---------------------------------------------------------------------------
# Progress reporting to the RISng webserver (best effort, never fatal).
# MAC is derived from BOOTIF (kernel cmdline) or /sys/class/net.
# ---------------------------------------------------------------------------
DIS_HOST="{{ tftp_server_ip }}"
MACADDR="$(grep -oE 'BOOTIF=01-([0-9A-Fa-f-]{17})' /proc/cmdline | head -n1 | sed -E 's/BOOTIF=01-//')"
if [ -z "${MACADDR}" ]; then
  IFACE="$(ip -o link show up | awk -F': ' '{print $2}' | grep -vE '^(lo|veth)' | head -n1 || true)"
  [ -n "${IFACE:-}" ] && MACADDR="$(cat /sys/class/net/${IFACE}/address 2>/dev/null || true)"
fi
if [ -n "${MACADDR:-}" ]; then
  curl -sf -m 10 -X POST "http://${DIS_HOST}/progress/" \
    --data-urlencode "mac=${MACADDR}" \
    --data-urlencode "phase=1" \
    --data-urlencode "step=pre" \
    --data-urlencode "status=running" \
    --data-urlencode "hostname=$(hostname 2>/dev/null || echo unknown)" \
    >/dev/null 2>&1 || true
fi
# ---------------------------------------------------------------------------
%end

%post --log=/var/log/risng-post.log
set -euxo pipefail
# Mark machine as RIS8-managed (phase 2/3 routing key)
echo 'RISNG_ROLE=ris8-base' > /etc/risng-role
echo 'RIS8_PHASE=1' >> /etc/risng-role

# Hostname: mac-based (stable identity until phase 3 assigns a real name)
MACADDR="$(grep -oE 'BOOTIF=01-([0-9A-Fa-f-]{17})' /proc/cmdline | head -n1 | sed -E 's/BOOTIF=01-//')"
if [ -z "${MACADDR:-}" ]; then
  IFACE="$(ip -o link show up | awk -F': ' '{print $2}' | grep -vE '^(lo|veth)' | head -n1 || true)"
  [ -n "${IFACE:-}" ] && MACADDR="$(cat /sys/class/net/${IFACE}/address 2>/dev/null || true)"
fi
if [ -n "${MACADDR:-}" ]; then
  HN="ris8-$(echo "${MACADDR}" | tr -d ':' | tr 'A-F' 'a-f' | cut -c7-20)"
  hostnamectl set-hostname "${HN}" || hostname "${HN}"
fi

# SSH key provisioning (controlhost public key published by RISng webserver)
install -d -m 0700 /root/.ssh
if curl -fsSL "http://{{ tftp_server_ip }}/bootstrap/controlhost_id_ed25519.pub" -o /tmp/risng-ctrl.pub; then
  cat /tmp/risng-ctrl.pub >> /root/.ssh/authorized_keys
  rm -f /tmp/risng-ctrl.pub
  chmod 0600 /root/.ssh/authorized_keys
fi

# Progress: base install finished, phase 2 expected via Ansible.
MACADDR="$(cat /sys/class/net/$(ip -o link show up | awk -F': ' '{print $2}' | grep -vE '^(lo|veth)' | head -n1)/address 2>/dev/null || true)"
if [ -n "${MACADDR:-}" ]; then
  curl -sf -m 10 -X POST "http://{{ tftp_server_ip }}/progress/" \
    --data-urlencode "mac=${MACADDR}" \
    --data-urlencode "phase=1" \
    --data-urlencode "step=done" \
    --data-urlencode "status=success" \
    >/dev/null 2>&1 || true
fi
%end
